        \u0422\u0430\u043C \u043C\u043E\u044F \u0431\u0430\u0431\u0443\u0448\u043A\u0430
        \u0436\u0438\u0432\u0435\u0442. \u041F\u043E\u043F\u0440\u043E\u0441\u0438
        \u0443 \u043D\u0435\u0435 \u043C\u043E\u044E \u0438\u0433\u043E\u043B\u043A\u0443.
